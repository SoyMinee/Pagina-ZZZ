{
  "version": 2,
  "builds": [
    {
      "src": "vercelserver.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "vercelserver.js"
    },
    {
      "src": "/(index\\.html)?",
      "dest": "index.html"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|json|svg|mp4|webp))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "vercelserver.js"
    }
  ]
}