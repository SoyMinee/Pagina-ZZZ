if(!("strCustomCSS" in window.cmp_config_data) || window.cmp_config_data.strCustomCSS==""){window.cmp_config_data.strCustomCSS = ".cmpstyleroot.cmpboxwcag,.cmpstyleroot.cmpboxwcag *{--x6pt:8px;--x7pt:8.751px;--x8pt:9.999px;--x9pt:12px;--x10pt:13.3328px;--x11pt:14.6656px;--x12pt:16px;}\r\n.cmplogo {\r\n  display: none!important;\r\n}\r\n#cmpbox {\r\n  z-index: 2001;\r\n  font-size: 16px;\r\n  border: none;\r\n  padding: 18px !important;\r\n  bottom: 20px;\r\n}\r\n.cmpboxbtns{\r\n  display: flex;\r\n  box-shadow: none;\r\n  align-items: center;\r\n}\r\n.cmpboxbtns >span{\r\n  display: block;\r\n}\r\n.cmptxt_btn_settings {\r\n  display: block;\r\n  width: auto;\r\n  padding: 3px 10px !important;\r\n  border-color: #e7e8ee;\r\n  color: #3C3F44 !important;\r\n  border: 1px solid rgb(231, 232, 238);\r\n}\r\n.cmpboxbtns >span {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n.cmpboxbtns >span >a {\r\n  display: block;\r\n  width: auto !important;\r\n  padding: 5px 14px !important;\r\n  box-shadow: none !important;\r\n  font-size: 12px !important;\r\n  border-radius: 8px;\r\n  margin-top: 0px !important;\r\n  margin-bottom: 0px !important;\r\n  margin-right: 0px !important;\r\n}\r\n.cmptxt_btn_settings {\r\n  border-bottom-width: 1px !important;\r\n  border-top-width: 1px !important;\r\n}\r\n.cmpmore {\r\n  display:flex;\r\n  align-items: center;\r\n  margin-left: 3px;\r\n}\r\n.cmpboxinner {\r\n  display: flex;\r\n  justify-content: space-between;\r\n}\r\n#cmpboxcontent {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.cmplanguage {\r\n  left: 18px;\r\n  bottom: 5px;\r\n  padding: 0px;\r\n}\r\n.cmpboxbtnno {\r\n  box-shadow: none;\r\n}\r\n.cmpmorelink {\r\n  font-size: 12px;\r\n}\r\n#cmpboxheadline1 {\r\n  display: none;\r\n}\r\n.cmpboxtxt span, .cmpboxinner {\r\n  font-weight: 400!important;\r\n  font-family: \"Microsoft YaHei\",sans-serif !important;\r\n}\r\n#cmpaltlangs, .cmpaltlang {\r\n  background: #ffffff;\r\n  border: 1px solid #ffffff;\r\n}\r\n.cmplanguage:focus, .cmplanguage:hover {\r\n  background: #ffffff;\r\n  border: 1px solid #ffffff;\r\n}\r\n.cmpboxrecall {\r\n  left: auto;\r\n  right: 10px;\r\n}\r\n@media (max-height: 926px) and (max-width: 480px) and (orientation: portrait) {\r\n  #cmpbox {\r\n    bottom: 0px;\r\n    max-height: auto;\r\n    max-height: 100%;\r\n    padding: 20px 15px 35px 15px !important;\r\n  }\r\n\r\n  .cmpbox {\r\n    min-height: auto!important;\r\n    max-height: auto!important;\r\n    height: auto!important;\r\n  }\r\n\r\n  .cmplanguage {\r\n    bottom: 10px;\r\n  }\r\n\r\n  .cmpboxcontent, .cmpboxbtns {\r\n    flex-grow: initial;\r\n  }\r\n\r\n  .cmpboxinner {\r\n    align-items: center;\r\n    justify-content: center;\r\n  }\r\n\r\n  .cmpboxbtns {\r\n    display: block;\r\n  }\r\n\r\n  .cmpboxbtns, .cmpboxbtns >span, .cmpboxbtns >span >a {\r\n    width: 100%;\r\n  }  \r\n\r\n  .cmpboxbtns >span >a {\r\n    width: 100% !important;\r\n    margin-top: 10px !important;\r\n    margin-left: 0px !important;\r\n    padding: 8px 14px !important\r\n  }\r\n\r\n  .cmpmore {\r\n    margin-top: 5px;\r\n    margin-left: 0px;\r\n  }\r\n}.cmpstyleroot, .cmpstyleroot *\r\n{\r\n    --clrBackground:    #FFFFFF;\r\n    --clrHeadline:      #3B3B3B;\r\n    --clrText:          #5F5F5F;\r\n    --clrTextSecondary: #CFCFCF;\r\n    --clrButton:        #4A88FC;\r\n    --clrButtonText:    #FFFFFF;\r\n    --clrLink:          #666666;\r\n    --clrHighlight:     #FFFDCD;\r\n}.cmplogo {left: 50%; transform: translate(-50%, 0) !important; top: 13px; right: auto !important;}@media (max-width: 570px){.cmplogo{ display: none !important;}}\r\n    @media (max-height: 926px) and (max-width: 480px) and (orientation: portrait){.cmplogo{display: none !important;}}\r\n    @media (max-width: 926px) and (max-height: 480px) and (orientation: landscape){.cmplogo{display: none !important;}} *.cmpboxhl{color:var(--clrHeadline);padding-bottom:10px;font-weight:bold;} *.cmpboxtxt, td.cmpvendname{color:v