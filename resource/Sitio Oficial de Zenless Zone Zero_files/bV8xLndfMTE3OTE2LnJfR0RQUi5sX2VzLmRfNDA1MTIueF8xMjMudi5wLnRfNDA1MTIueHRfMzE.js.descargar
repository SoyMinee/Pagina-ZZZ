window.cmp_svg_icoprv34=function(){return new cmp_html("svg",{"xmlns":"http:\/\/www.w3.org\/2000\/svg","xmlns:svg":"http:\/\/www.w3.org\/2000\/svg","enable-background":"new 0 0 24 24","height":"24px","viewBox":"0 0 24 24","width":"24px","class":"cmpicosvgfill"}, "", function (x){x.child("g", {}, "", true, function (x){x.child("rect", {"fill":"none","height":"24","width":"24"})}).child("path", {"d":"M18,11c0,0.67,0,1.33,0,2c1.2,0,2.76,0,4,0c0-0.67,0-1.33,0-2C20.76,11,19.2,11,18,11z"}).child("path", {"d":"M16,17.61c0.96,0.71,2.21,1.65,3.2,2.39c0.4-0.53,0.8-1.07,1.2-1.6c-0.99-0.74-2.24-1.68-3.2-2.4 C16.8,16.54,16.4,17.08,16,17.61z"}).child("path", {"d":"M20.4,5.6C20,5.07,19.6,4.53,19.2,4c-0.99,0.74-2.24,1.68-3.2,2.4c0.4,0.53,0.8,1.07,1.2,1.6 C18.16,7.28,19.41,6.35,20.4,5.6z"}).child("path", {"d":"M4,9c-1.1,0-2,0.9-2,2v2c0,1.1,0.9,2,2,2h1v4h2v-4h1l5,3V6L8,9H4z M9.03,10.71L11,9.53v4.94l-1.97-1.18L8.55,13H8H4v-2h4 h0.55L9.03,10.71z"}).child("path", {"d":"M15.5,12c0-1.33-0.58-2.53-1.5-3.35v6.69C14.92,14.53,15.5,13.33,15.5,12z"})});};
window.cmp_config_data["purposeicon46"] = "cmp_svg_icoprv46";window.cmp_config_data["purposeicon30"] = "cmp_svg_icoprv30";window.cmp_config_data["purposeicon34"] = "cmp_svg_icoprv34";window.cmp_config_data.customLang = [{"strLang":"ES","strType":"btn_more","strText":"Pol\u00edtica de cookies","intTextVersion":125770},{"strLang":"ES","strType":"hl","strText":"Preferencias de privacidad","intTextVersion":125771},{"strLang":"ES","strType":"txt","strText":"<div data-v-0e1d7e05=\"\" data-v-291c812a=\"\" data-type=\"paragraph\" data-lineno=\"2\"><span data-v-ea2b014a=\"\" data-v-0e1d7e05=\"\" data-type=\"text\" style=\"text-decoration-thickness: 1px; text-underline-offset: 0.134em;\">Utilizamos cookies para analizar y optimizar tu experiencia de navegaci\u00f3n y mercadotecnia. Al presionar en \"Aceptar\", confirmas que est\u00e1s de acuerdo con su uso.<\/span><\/div>","intTextVersion":130842},{"strLang":"ES","strType":"btn_yes","strText":"Aceptar","intTextVersion":1},{"strLang":"ES","strType":"btn_reject","strText":"Rechazar todo","intTextVersion":1},{"strLang":"ES","strType":"litxt","strText":"Tenga en cuenta que algunos proveedores procesar\u00e1n datos personales en funci\u00f3n de un inter\u00e9s leg\u00edtimo. Tiene derecho a oponerse a este tratamiento. Para hacer esto, haga clic en \"Configuraci\u00f3n personalizada\" y desactive los proveedores."},{"strLang":"ES","strType":"storagetxt","strText":"Las elecciones que usted realiza con respecto a los prop\u00f3sitos y entidades enumerados en este aviso se guardan en una cookie llamada [tcfcookiename] por una duraci\u00f3n m\u00e1xima de [tcfcookieduration] d\u00edas."},{"strLang":"ES","strType":"hl_reconsent","strText":""},{"strLang":"ES","strType":"txt_reconsent","strText":""},{"strLang":"ES","strType":"txt_att","strText":""},{"strLang":"ES","strType":"hl_custom","strText":"Personaliza tu elecci\u00f3n"},{"strLang":"ES","strType":"txt_custom","strText":"En esta p\u00e1gina puede encontrar m\u00e1s informaci\u00f3n sobre los prop\u00f3sitos del procesamiento de datos y los proveedores que utilizamos en nuestras p\u00e1ginas web."},{"strLang":"ES","strType":"btn_no","strText":"Rechazar todo"},{"strLang":"ES","strType":"btn_accept","strText":"Aceptar"},{"strLang":"ES","strType":"btn_save","strText":"Guardar + Salir"},{"strLang":"ES","strType":"btn_yes2","strText":""},{"strLang":"ES","strType":"btn_no2","strText":""},{"strLang":"ES","strType":"btn_save2","strText":""},{"strLang":"ES","strType":"btn_continue","strText":"Rechazar todo"},{"strLang":"ES","strType":"btn_settings","strText":"Configuraciones"},{"strLang":"ES","strType":"btn_ccpaok","strText":"Okay"},{"strLang":"ES","strType":"btn_ccpaooall","strText":"Darse de baja de todos"},{"strLang":"ES","strType":"btn_ccpasaveselection","strText":"Guardar selecci\u00f3n"},{"strLang":"ES","strType":"btn_ccpaallowall","strText":"Permitir todo"},{"strLang":"ES","strType":"btn_custom","strText":"Personaliza tu elecci\u00f3n"},{"strLang":"ES","strType":"btn_back","strText":"Volver a la p\u00e1gina principal"},{"strLang":"ES","strType":"cookies","strText":"Cookies"},{"strLang":"ES","strType":"btn_tac","strText":"T&C"},{"strLang":"ES","strType":"btn_imprint","strText":"Impresi\u00f3n "},{"strLang":"ES","strType":"ccpadns","strText":"No venda mi informaci\u00f3n personal"},{"strLang":"ES","strType":"savepref","strText":"Recordar mi elecci\u00f3n (establecer cookies)"},{"strLang":"ES","strType":"hl_cookies","strText":"Cookies"},{"strLang":"ES","strType":"txt_cookies","strText":"En nuestra p\u00e1gina web, nosotros y nuestros socios podemos establecer las siguientes cookies:"},{"strLang":"ES","strType":"cookiename","strText":"Nombre de la cookie"},{"strLang":"ES","strType":"cookiesample","strText":"Valor de la muestra"},{"strLang":"ES","strType":"expire","strText":"Caducar"},{"strLang":"ES","strType":"domain","strText":"Dominio"},{"strLang":"ES","strType":"cookietype","strText":"Tipo"},{"strLang":"ES","strType":"cookietype_0","strText":"[desconocido]"},{"strLang":"ES","strType":"cookietype_1","strText":"Funci\u00f3n"},{"strLang":"ES","strType":"cookietype_2","strText":"M\u00e1rketing"},{"strLang":"ES","strType":"cookietype_3","strText":"Preferencias"},{"strLang":"ES","strType":"cookietype_4","strText":"Medici\u00f3n"},{"strLang":"ES","strType":"cookietype_5","strText":"Otro"},{"strLang":"ES","strType":"cookietype_6","strText":"Social media"},{"strLang":"ES","strType":"cookieinfo_hl","strText":"Administra tus cookies"},{"strLang":"ES","strType":"cookieinfo_text","strText":"<p>Hay varias formas de administrar la configuraci\u00f3n relacionada con las cookies y, si es necesario, dar o retirar el consentimiento.:<\/p>\r\n<p>Los usuarios pueden gestionar la configuraci\u00f3n de las cookies directamente desde la configuraci\u00f3n de su propio dispositivo, por ejemplo,impedir el uso o almacenamiento de cookies.<\/p>\r\n<p>Cuando el uso de cookies se basa en el consentimiento, los usuarios tambi\u00e9n pueden aceptar o rechazar configurando sus preferencias en el aviso de cookies o actualizando esas preferencias como deseen a trav\u00e9s del widget de preferencias de consentimiento correspondiente, donde est\u00e9 disponible.<\/p>\r\n<p>Tambi\u00e9n es posible eliminar las cookies guardadas anteriormente,incluidas las utilizadas para recordar el consentimiento inicial del usuario,a trav\u00e9s de las funcionalidades correspondientes del navegador o dispositivo final.<\/p>\r\n<p>Borrar su historial de navegaci\u00f3n puede eliminar otras cookies del almacenamiento local de su navegador.<\/p>\r\n<p>Con respecto a las cookies del proveedores de externos, los usuarios pueden administrar sus preferencias y retirar su consentimiento a trav\u00e9s del enlace de exclusi\u00f3n correspondiente (si est\u00e1 disponible),\r\nutilizando los medios especificados en la pol\u00edtica de privacidad del provedores de externos o poni\u00e9ndose en contacto con los proveedores de externos.<\/p>\r\n<h4>Encuentra la configuraci\u00f3n de cookies<\/h4>\r\n<p>Por ejemplo, en las siguientes direcciones, los usuarios pueden encontrar informaci\u00f3n sobre c\u00f3mo gestionar las cookies en los navegadores m\u00e1s utilizados:<\/p>\r\n<ul>\r\n  <li><a rel=\"noopener nofollow\" target=\"_blank\" href=\"https:\/\/support.google.com\/chrome\/answer\/95647?hl=es&p=cpn_cookies\">Google Chrome<\/a><\/li>\r\n  <li><a rel=\"noopener nofollow\" target=\"_blank\" href=\"https:\/\/support.mozilla.org\/es\/kb\/Habilitar-y-deshabilitar-las-cookies-de-estos-sitios-web\">Mozilla Firefox<\/a><\/li>\r\n  <li><a rel=\"noopener nofollow\" target=\"_blank\" href=\"https:\/\/support.apple.com\/es-es\/guide\/safari\/manage-cookies-and-website-data-sfri11471\/\">Apple Safari<\/a><\/li>\r\n  <li><a rel=\"noopener nofollow\" target=\"_blank\" href=\"http:\/\/windows.microsoft.com\/es-es\/windows-vista\/block-or-allow-cookies\">Microsoft Internet Explorer<\/a><\/li>\r\n  <li><a rel=\"noopener nofollow\" target=\"_blank\" href=\"http:\/\/windows.microsoft.com\/es-es\/windows-vista\/block-or-allow-cookies\">Microsoft Edge<\/a><\/li>\r\n  <li><a rel=\"noopener nofollow\" target=\"_blank\" href=\"https:\/\/support.brave.com\/hc\/articles\/360022806212-How-do-I-use-Shields-while-browsing\">Brave<\/a><\/li>\r\n  <li><a rel=\"noopener nofollow\" target=\"_blank\" href=\"https:\/\/help.opera.com\/latest\/web-preferences\/#cookies\">Opera<\/a><\/li>\r\n<\/ul>\r\n<p>Los usuarios tambi\u00e9n pueden administrar ciertas categor\u00edas de cookies utilizadas en las aplicaciones m\u00f3viles deshabilit\u00e1ndolas a trav\u00e9s de la configuraci\u00f3n del dispositivo correspondiente, como: B. Configuraci\u00f3n de publicidad del dispositivo para dispositivos m\u00f3viles o configuraci\u00f3n de seguimiento en general (los usuarios pueden abrir la configuraci\u00f3n del dispositivo y encontrar la opci\u00f3n adecuada).<\/p>\r\n<h4>C\u00f3mo optar por no recibir publicidad basada en intereses<\/h4>\r\n<p>Sin perjuicio de lo anterior, se informa a los usuarios que podr\u00e1n seguir las instrucciones de <a target=\"_blank\" rel=\"noopener nofollow\" href=\"http:\/\/www.youronlinechoices.eu\/\">YourOnlineChoices<\/a> (UE), la <a target=\"_blank\" rel=\"noopener nofollow\" href=\"https:\/\/thenai.org\/about-online-advertising\/\">Network Advertising Initiative<\/a> (EE.UU.) y la <a target=\"_blank\" rel=\"noopener nofollow\" href=\"https:\/\/www.aboutads.info\/consumers\/\">Digital Advertising Alliance<\/a>  (EE.UU.), <a target=\"_blank\" rel=\"noopener nofollow\" href=\"https:\/\/youradchoices.ca\/understanding-online-advertising\/\">DAAC<\/a> (Canad\u00e1), <a target=\"_blank\" rel=\"noopener nofollow\" href=\"http:\/\/www.ddai.info\/optout\">DDAI<\/a> (Jap\u00f3n) u otros servicios similares. Tales iniciativas permiten a los Usuarios seleccionar sus preferencias de seguimiento para la mayor\u00eda de las herramientas de publicidad. El Titular, por tanto, recomienda que el Usuario utilice estos recursos adem\u00e1s de la informaci\u00f3n proporcionada en el presente documento.\r\nDigital Advertising Alliance ofrece una aplicaci\u00f3n llamada <a target=\"_blank\" rel=\"noopener nofollow\" href=\"https:\/\/youradchoices.com\/appchoices\">AppChoices<\/a> que ayuda a los usuarios a controlar la publicidad basada en intereses en aplicaciones m\u00f3viles.<\/p>\r\n<h4>Consecuencias de negar el consentimiento<\/h4>\r\n<p>El usuario es libre de dar su consentimiento o no. Sin embargo, debe tenerse en cuenta que las cookies ayudan a este sitio web a brindar a los usuarios una mejor experiencia y funcionalidad mejorada (en l\u00ednea con los prop\u00f3sitos establecidos en este documento). Por lo tanto, sin el consentimiento del usuario, es posible que el propietario no pueda proporcionar las funciones pertinentes.<\/p>"},{"strLang":"ES","strType":"vendorinfo_company","strText":"Empresa que procesa los datos"},{"strLang":"ES","strType":"vendorinfo_cookies","strText":"Cookies, instaladas en su navegador"},{"strLang":"ES","strType":"vendorinfo_legal","strText":"Base jur\u00eddica para el tratamiento de datos"},{"strLang":"ES","strType":"vendorinfo_purposes","strText":"Prop\u00f3sitos para el tratamiento de datos"},{"strLang":"ES","strType":"subservices","strText":"Subservices"},{"strLang":"ES","strType":"txtsubservices","strText":"When enabling this vendor, other vendors will also be enabled. These are:"},{"strLang":"ES","strType":"show_vendors","strText":"Mostrar proveedores"},{"strLang":"ES","strType":"companyinfo_datacontroller","strText":"Controlador de datos"},{"strLang":"ES","strType":"companyinfo_controllertext","strText":"El controlador de datos (RGPD Art 4.7) es la siguiente empresa:"},{"strLang":"ES","strType":"companyinfo_tel","strText":"Tel\u00e9fono"},{"strLang":"ES","strType":"companyinfo_mail","strText":"Email"},{"strLang":"ES","strType":"companyinfo_website","strText":"Sitio web"},{"strLang":"ES","strType":"companyinfo_dpo","strText":"Delegado de protecci\u00f3n de datos"},{"strLang":"ES","strType":"companyinfo_dpotext","strText":"Puede comunicarse con nuestro delegado de protecci\u00f3n de datos de la siguiente manera:"},{"strLang":"ES","strType":"hl_preview","strText":"Necesitamos su aprobaci\u00f3n"},{"strLang":"ES","strType":"txt_preview","strText":"Este contenido es proporcionado por [vendorname]. Al habilitar este contenido, el proveedor puede procesar sus datos personales y se pueden establecer cookies."},{"strLang":"ES","strType":"btn_preview","strText":"Aceptar"},{"strLang":"ES","strType":"cb_preview","strText":"Siempre acepte [vendorname]"},{"strLang":"ES","strType":"purpose","strText":"Prop\u00f3sito"},{"strLang":"ES","strType":"vendor","strText":"Proveedor"},{"strLang":"ES","strType":"vendors","strText":"Vendors"},{"strLang":"ES","strType":"unknown_vendor","strText":"vendedor desconocido"},{"strLang":"ES","strType":"all_purposes","strText":"Todos los prop\u00f3sitos"},{"strLang":"ES","strType":"all_vendors","strText":"Todos los proveedores"},{"strLang":"ES","strType":"on","strText":"Encendido"},{"strLang":"ES","strType":"off","strText":"Apagado"},{"strLang":"ES","strType":"always_on","strText":"Siempre encendido"},{"strLang":"ES","strType":"year","strText":"A\u00f1o"},{"strLang":"ES","strType":"month","strText":"Mes"},{"strLang":"ES","strType":"day","strText":"D\u00eda"},{"strLang":"ES","strType":"age","strText":"A\u00f1os"},{"strLang":"ES","strType":"recallbtn","strText":"La configuraci\u00f3n de privacidad"},{"strLang":"ES","strType":"load","strText":"Cargando"},{"strLang":"ES","strType":"close","strText":"Close"},{"strLang":"ES","strType":"your_choice","strText":"Your choice"},{"strLang":"ES","strType":"consent","strText":"Consentimiento"},{"strLang":"ES","strType":"legint","strText":"Inter\u00e9s leg\u00edtimo"},{"strLang":"ES","strType":"legintdescr","strText":"Para algunos prop\u00f3sitos y\/o proveedores utilizamos la base legal \"Inter\u00e9s leg\u00edtimo\" (RGPD 6.1.f)."},{"strLang":"ES","strType":"noneu","strText":"Transferencias de datos fuera de la UE"},{"strLang":"ES","strType":"noneudescr","strText":"Algunos proveedores pueden transferir, almacenar o procesar sus datos personales fuera del EEE\/UE. Estos pa\u00edses pueden no tener el mismo nivel de protecci\u00f3n de datos y la aplicaci\u00f3n de sus derechos puede ser limitada o imposible."},{"strLang":"ES","strType":"noneudescr2","strText":"Este proveedor puede transferir, almacenar o procesar sus datos personales fuera del EEE\/UE. Estos pa\u00edses pueden no tener el mismo nivel de protecci\u00f3n de datos y la aplicaci\u00f3n de sus derechos puede ser limitada o imposible."},{"strLang":"ES","strType":"features","strText":"Caracter\u00edsticas"},{"strLang":"ES","strType":"privacypolicy","strText":"Pol\u00edtica de privacidad"},{"strLang":"ES","strType":"description","strText":"Descripci\u00f3n"},{"strLang":"ES","strType":"language","strText":"Idioma"},{"strLang":"ES","strType":"txt_qr","strText":"You can scan the following QR code with your mobile phone in order to see the content on your phone. Otherwise you can click on the link below in order to access it directly."},{"strLang":"ES","strType":"this_website_app","strText":"this website\/app"},{"strLang":"ES","strType":"designurl_pcp","strText":"https:\/\/..."},{"strLang":"ES","strType":"designurl_imprint","strText":"https:\/\/..."},{"strLang":"ES","strType":"designurl_tac","strText":"https:\/\/..."},{"strLang":"ES","strType":"cp_welcometext","strText":"Visite este sitio web como de costumbre con publicidad y seguimiento. Puede revocar su consentimiento en cualquier momento a trav\u00e9s de la pol\u00edtica de privacidad."},{"strLang":"ES","strType":"cp_welcomesubtext","strText":"Puede encontrar m\u00e1s informaci\u00f3n sobre publicidad y seguimiento en nuestra [link=privacy] pol\u00edtica de privacidad [\/link] o en nuestro [link=settings] centro de privacidad [\/link]."},{"strLang":"ES","strType":"cp_welcomeheadline","strText":"... o con contentpass"},{"strLang":"ES","strType":"cp_welcomepasstext","strText":"Visite este sitio web completamente libre de publicidad, seguimiento personalizado y comerciales desde [cp_price] [cp_currency_html] \/ mes."},{"strLang":"ES","strType":"cp_already_signedup","strText":"\u00bfYa eres miembro de contentpass?"},{"strLang":"ES","strType":"cp_btntxt","strText":"Sin publicidad por [cp_price] [cp_currency_html] \/ mes"},{"strLang":"ES","strType":"cp_login","strText":"Acceso"},{"strLang":"ES","strType":"welect_welcomeheadline","strText":"... o ver un video promocional"},{"strLang":"ES","strType":"welect_welcomepasstext","strText":"Mire un video promocional y obtenga acceso gratuito a este sitio web durante [welect_minutes] minutos sin anuncios personalizados ni seguimiento."},{"strLang":"ES","strType":"welect_btntxt","strText":"Elige un v\u00eddeo"},{"strLang":"ES","strType":"adchoices","strText":"AdChoices"},{"strLang":"ES","strType":"adchoices_adjust_url","strText":"Adjust Ad Preferences Across the Web"},{"strLang":"ES","strType":"adchoices_about_url","strText":"Learn more about AdChoices"},{"strLang":"ES","strType":"adchoices_headline","strText":"About Our Ads"},{"strLang":"ES","strType":"adchoices_subtext","strText":"Data collected from your browser or app is used to improve your ad experiences and our services."},{"strLang":"ES","strType":"adchoices_descr","strText":"Do you want to opt out of interest-based advertising, or would you like to customize your categories of interest to improve the advertisements you see across the web?"},{"strLang":"ES","strType":"hl_dsa_info","strText":"Information about Advertising on this Website"},{"strLang":"ES","strType":"hl_dsa_adtxt","strText":"The following ad has used personal data to determine that this ad should be presented to you."},{"strLang":"ES","strType":"h2_dsa_why","strText":"Why do I see this Advertising?"},{"strLang":"ES","strType":"dsa_whytxt","strText":"The following companies where involved in the decision-making process and used personal data in order to determine that this advertising should be presented to you:"},{"strLang":"ES","strType":"dsa_adsbasedon","strText":"The company used the following main parameters to determine to present the ad to you:"},{"strLang":"ES","strType":"dsa_param_1","strText":"Information about your activity, interests, demographic information, or other characteristics. Information may be collected and used acress contexts."},{"strLang":"ES","strType":"dsa_param_2","strText":"Real-time information about the context in which the ad will be shown.  This includes information about the content and your device, such as your device type and capabilities, user agent, URL, IP address, or non-precise geolocation data. Additionally, use of basic cross-context information not based on your behavior or characteristics, for uses such as frequency capping, sequencing, brand safety, anti-fraud."},{"strLang":"ES","strType":"dsa_param_3","strText":"Precise real-time geolocation of your device, i.e. GPS coordinates within 500 meter radius precision."},{"strLang":"ES","strType":"h2_dsa_who","strText":"About the Advertiser"},{"strLang":"ES","strType":"dsa_behalf","strText":"The advertising is presented on behalf of:"},{"strLang":"ES","strType":"dsa_paidby","strText":"The advertising is paid by:"},{"strLang":"ES","strType":"h2_dsa_ad","strText":"About this Advertising"},{"strLang":"ES","strType":"dsa_adid","strText":"Ad ID"},{"strLang":"ES","strType":"dsa_url","strText":"URL"},{"strLang":"ES","strType":"dsa_detailbtn","strText":"Show Details"},{"strLang":"ES","strType":"dsa_iurl","strText":"Preview"},{"strLang":"ES","strType":"h2_dsa_adjust","strText":"Adjust your Advertising preferences"},{"strLang":"ES","strType":"dsa_adjusttxt","strText":"You can update your advertising preferences at any time by clicking on the icon in the left lower corner of the website."},{"strLang":"ES","strType":"dsa_custombtn","strText":"Customize your choices"},{"strLang":"ES","strType":"hl_dsa_list","strText":"Advertising on this page"},{"strLang":"ES","strType":"hl_dsa_listtxt","strText":"The following ads on this page have used personal data to determine that this ad should be presented to you. Click on the details link in order to see further information."},{"strLang":"ES","strType":"data_cats_clickpath","strText":"Clickpath"},{"strLang":"ES","strType":"data_cats_financial_information","strText":"Informaci\u00f3n financiera"},{"strLang":"ES","strType":"data_cats_fraud_detectionprevention","strText":"Detecci\u00f3n y prevenci\u00f3n de fraudes"},{"strLang":"ES","strType":"data_cats_ip","strText":"IP"},{"strLang":"ES","strType":"data_language","strText":"Idioma"},{"strLang":"ES","strType":"data_cats_tracking_user_location","strText":"Seguimiento de la ubicaci\u00f3n del usuario"},{"strLang":"ES","strType":"data_cats_offlinedata","strText":"Coincidir y combinar con datos fuera de l\u00ednea"},{"strLang":"ES","strType":"data_cats_measuring_visibility_of_ads","strText":"Medir la visibili